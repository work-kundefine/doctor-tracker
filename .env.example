# PORT: Server port (defaults to 3000 in AI Studio environment)
PORT=3000

# NODE_ENV: Application environment
NODE_ENV=development

# MONGODB_URI: Connection string for MongoDB (defaults to local or fallback cluster)
MONGODB_URI="mongodb://127.0.0.1:27017/doctortracker"

# JWT_SECRET: Secret passphrase used to sign and verify JSON Web Tokens
JWT_SECRET="clinical_intelligence_doctortracker_jwt_secret_token_2026"
JWT_EXPIRES_IN="12h"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
